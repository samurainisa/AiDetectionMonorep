# ===== Скопируй в .env на сервере и заполни значениями =====

# БД (PostgreSQL внутри docker-compose)
POSTGRES_USER=postgres
# Придумай надёжный пароль (буквы+цифры, без пробелов):
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Flask секрет — сгенерируй командой:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_min_32_random_chars

# Ключ Pangram API
PANGRAM_API_KEY=CHANGE_ME_pangram_api_key

# Режим детекции: pangram_only | pangram_plus_ai
AI_MODE=pangram_only

# Без GPU
CUDA_VISIBLE_DEVICES=-1

# Не ставить тяжёлые train-зависимости в образ
INSTALL_TRAINING_DEPS=false

# Разрешённые источники для CORS (через запятую)
CORS_ORIGINS=https://ai-detection.ru,https://www.ai-detection.ru

# Ключ, который фронт зашивает в сборку (если используется)
VITE_API_KEY=CHANGE_ME_frontend_api_key
